function degreesToRadians(e){return e*(Math.PI/180)}function radiansToDegrees(e){return e/(Math.PI/180)}function MercatorProjection(){var e=256;this.pixelOrigin_=new google.maps.Point(e/2,e/2),this.pixelsPerLonDegree_=e/360,this.pixelsPerLonRadian_=e/(2*Math.PI)}MercatorProjection.prototype.fromDivPixelToLatLng=function(e,v){var i=this,a=i.pixelOrigin_,t=Math.pow(2,v),u=(e.x/t-a.x)/i.pixelsPerLonDegree_,o=(e.y/t-a.y)/-i.pixelsPerLonRadian_,s=radiansToDegrees(2*Math.atan(Math.exp(o))-Math.PI/2);return new google.maps.LatLng(s,u)},MercatorProjection.prototype.fromDivPixelToSphericalMercator=function(e,v){var i=this,a=i.fromDivPixelToLatLng(e,v),t=6378137,u=t*degreesToRadians(a.lng()),o=degreesToRadians(a.lat()),s=t/2*Math.log((1+Math.sin(o))/(1-Math.sin(o)));return new google.maps.Point(u,s)};function createWmsOverlay(e,v,i,a,t,u,o){var s=256,P=256,l=[],x={getTileUrl:function(g,d){var f=new google.maps.Point(g.x*256,(g.y+1)*256),h=new google.maps.Point((g.x+1)*256,g.y*256),n=new MercatorProjection,p=n.fromDivPixelToSphericalMercator(f,d),y=n.fromDivPixelToSphericalMercator(h,d),M=p.y,L=p.x,T=y.y,c=y.x;c<L&&(c=Math.abs(c));var m=v+"&bbox="+L+","+M+","+c+","+T,R=$.inArray(m,l);return R<0&&l.push(m),l.length===1&&$(r).trigger("overlay-busy"),m},tileSize:new google.maps.Size(s,P),minZoom:a,maxZoom:t,opacity:i,isPng:!0},r=new google.maps.ImageMapType(x);return $(r).bind("overlay-idle",function(){$(e.getDiv()).trigger("overlay-loaded",[o])}),$(r).bind("overlay-busy",function(){}),r.baseGetTile=r.getTile,r.getTile=function(g,d,f){var h=r.baseGetTile(g,d,f);return $(h).bind("DOMNodeInserted DOMSubtreeModified",function(){var n=$("img",this);n.length>0&&(n.one("load",function(){var p=$.inArray(this.src,l);p>=0&&(l.splice(p,1),l.length===0&&$(r).trigger("overlay-idle"))}),n[0].complete&&n.trigger("load"))}),h},r}
