Geometry=function(){var i=function(t,n){this.x=null,this.y=null,n==null&&t.hasOwnProperty("x")?(this.x=t.x,this.y=t.y):(this.x=t,this.y=n)};i.prototype.Dot=function(t){return this.x*t.x+this.y*t.y},i.prototype.Norm=function(){var t=this.Dot(this);return Math.sqrt(t)},i.prototype.Add=function(t){return new i(this.x+t.x,this.y+t.y)},i.prototype.Multiply=function(t){return new i(this.x*t,this.y*t)},i.prototype.Minus=function(t){return new i(this.x-t.x,this.y-t.y)},i.prototype.Distance=function(t){return this.Minus(t).Norm()};var h=function(t,n){this.p0=null,this.p1=null,n==null&&t.hasOwnProperty("p0")?(this.p0=t.p0,this.p1=t.p1):(this.p0=t,this.p1=n)};return{Point:i,Vector:i,Segment:h,DistanceFromPointToSegment:function(t,n){var r=n.p1.Minus(n.p0),a=t.Minus(n.p0),e=a.Dot(r);if(e<=0)return{distance:t.Distance(n.p0),point:n.p0,isend:0};var s=r.Dot(r);if(s<=e)return{distance:t.Distance(n.p1),point:n.p1,isend:1};var u=e/s,o=n.p0.Add(r.Multiply(u));return{distance:t.Distance(o),point:o,isend:null}},IsCollinear:function(t,n,r,a){var e=t.x-n.x,s=t.y-n.y,u=r.x-n.x,o=r.y-n.y,p=(e*u+s*o)/(Math.sqrt(e*e+s*s)*Math.sqrt(u*u+o*o));return Math.abs(p)>=(a||.99)}}}();
